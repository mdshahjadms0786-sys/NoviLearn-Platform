# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/novilearn?schema=public"

# API
PORT=3001
NODE_ENV=development
API_URL=http://localhost:3001

# Web
WEB_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# Mobile (Expo)
EXPO_PUBLIC_API_URL=http://localhost:3001
# Note: use http://<LAN-IP>:3001 when running on a physical device via Expo Go.

# Authentication (JWT bearer tokens; tokenVersion on User enables revocation on logout)
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# AI Tutor (server-side only; never shipped to Web or Mobile)
# AI_PROVIDER is currently supported: openai (empty = AI Tutor disabled with a clear config error)
AI_PROVIDER=openai
AI_API_KEY=sk-your-openai-api-key
AI_MODEL=gpt-4o-mini

# File Storage (future phase)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=

# Email (future phase)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Monitoring (future phase)
SENTRY_DSN=
LOG_LEVEL=debug