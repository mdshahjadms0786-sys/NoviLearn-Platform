{
  "name": "novilearn",
  "version": "0.0.1",
  "private": true,
  "description": "NoviLearn - AI-powered learning platform for students",
  "scripts": {
    "dev": "pnpm --filter=@novilearn/api dev",
    "dev:web": "pnpm --filter=@novilearn/web dev",
    "dev:mobile": "pnpm --filter=@novilearn/mobile dev",
    "dev:all": "pnpm run dev & pnpm run dev:web & pnpm run dev:mobile",
    "build": "pnpm -r run build",
    "build:web": "pnpm --filter=@novilearn/web build",
    "lint": "pnpm -r run lint",
    "lint:fix": "pnpm -r run lint:fix",
    "format": "prettier --write \"**/*.{js,jsx,json,md,css,scss}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,json,md,css,scss}\"",
    "db:generate": "pnpm --filter=@novilearn/api db:generate",
    "db:push": "pnpm --filter=@novilearn/api db:push",
    "db:studio": "pnpm --filter=@novilearn/api db:studio",
    "clean": "pnpm -r run clean && rm -rf node_modules .turbo",
    "prepare": "husky install"
  },
  "devDependencies": {
    "eslint": "^9.10.0",
    "husky": "^9.1.6",
    "prettier": "^3.3.3",
    "turbo": "^2.1.2"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@11.4.0"
}
