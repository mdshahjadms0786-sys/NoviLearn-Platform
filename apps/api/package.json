{
  "name": "@novilearn/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.js",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "lint": "eslint src --ext .js",
    "lint:fix": "eslint src --ext .js --fix",
    "db:generate": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "db:diff": "prisma migrate diff",
