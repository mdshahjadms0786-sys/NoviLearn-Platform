generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String               @id @default(uuid())
  email              String               @unique
  name               String
  password           String
  role               String               @default("student")
  tokenVersion       Int                    @default(0)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  learningActivities LearningActivity[]
  practiceSessions   PracticeSession[]
  activePracticeSessions ActivePracticeSession[]

  @@map("users")
}

model LearningActivity {
  id        String   @id @default(uuid())
  userId    String
  topic     String
  type      String   @default("learn")
  metadata  Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, topic])
  @@map("learning_activities")
}

model PracticeSession {
  id               String   @id @default(uuid())
  userId           String
  topic            String
  questionCount    Int
  difficulty       String
  questionType     String
  totalQuestions   Int
  correctAnswers   Int
  incorrectAnswers Int
  accuracy         Int
  score            Int
  results          Json
  completedAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, completedAt(sort: Desc)])
  @@index([userId, topic])
  @@map("practice_sessions")
}

model KnowledgeChunk {
  id         String   @id @default(uuid())
  source     String
  title      String
  topic      String
  content    String
  metadata   Json?
  embedding  Float[]    @default([])
  checksum   String   @unique
  chunkIndex Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([source, chunkIndex])
  @@index([topic])
  @@map("knowledge_chunks")
}

model RateLimitBucket {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime @default(now())
  expiresAt   DateTime
  updatedAt   DateTime @updatedAt

  @@index([expiresAt])
  @@map("rate_limit_buckets")
}

model AiRecentEntry {
  userId      String   @id
  requestHash String
  requestedAt DateTime
  createdAt   DateTime @default(now())

  @@map("ai_recent_entries")
}

model ActivePracticeSession {
  id        String   @id @default(uuid())
  userId    String
  data      Json
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("active_practice_sessions")
}

model Topic {
  slug        String   @id
  name        String
  category    String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([name])
  @@map("topics")
}