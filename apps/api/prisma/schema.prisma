generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String                  @id @default(uuid())
  email                 String                  @unique
  name                  String
  password              String
  role                  String                  @default("student")
  tokenVersion          Int                     @default(0)
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  learningActivities    LearningActivity[]
  practiceSessions      PracticeSession[]
  activePracticeSessions ActivePracticeSession[]
  learningSessions      LearningSession[]
  savedLearnings        SavedLearning[]
  preferences           UserPreference?
  avatars               UserAvatar[]
  videoJobs             VideoJob[]
  fileUploads           FileUpload[]

  @@map("users")
}

model LearningActivity {
  id        String   @id @default(uuid())
  userId    String
  topic     String
  type      String   @default("learn")
  sessionId String?
  metadata  Json?
  createdAt DateTime @default(now())

  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  session LearningSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, topic])
  @@index([sessionId])
  @@map("learning_activities")
}

model PracticeSession {
  id               String   @id @default(uuid())
  userId           String
  topic            String
  questionCount    Int
  difficulty       String
  questionType     String
  totalQuestions   Int
  correctAnswers   Int
  incorrectAnswers Int
  accuracy         Int
  score            Int
  results          Json
  completedAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, completedAt(sort: Desc)])
  @@index([userId, topic])
  @@map("practice_sessions")
}

model KnowledgeChunk {
  id         String   @id @default(uuid())
  source     String
  title      String
  topic      String
  content    String
  metadata   Json?
  embedding  Float[]  @default([])
  checksum   String   @unique
  chunkIndex Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([source, chunkIndex])
  @@index([topic])
  @@map("knowledge_chunks")
}

model RateLimitBucket {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime @default(now())
  expiresAt   DateTime
  updatedAt   DateTime @updatedAt

  @@index([expiresAt])
  @@map("rate_limit_buckets")
}

model AiRecentEntry {
  userId      String   @id
  requestHash String
  requestedAt DateTime
  createdAt   DateTime @default(now())

  @@map("ai_recent_entries")
}

model ActivePracticeSession {
  id        String   @id @default(uuid())
  userId    String
  data      Json
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("active_practice_sessions")
}

model Topic {
  slug        String   @id
  name        String
  category    String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([name])
  @@map("topics")
}

// ─── NEW MODELS ───────────────────────────────────────────────

model LearningSession {
  id        String   @id @default(uuid())
  userId    String
  topic     String
  title     String
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages   LearningMessage[]
  activities LearningActivity[]
  saved      SavedLearning[]
  videoJobs  VideoJob[]

  @@index([userId, updatedAt(sort: Desc)])
  @@index([userId, status])
  @@map("learning_sessions")
}

model LearningMessage {
  id        String   @id @default(uuid())
  sessionId String
  role      String
  content   String
  metadata  Json?
  mode      String?
  createdAt DateTime @default(now())

  session LearningSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@map("learning_messages")
}

model SavedLearning {
  id        String   @id @default(uuid())
  userId    String
  sessionId String
  createdAt DateTime @default(now())

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  session LearningSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([userId, sessionId])
  @@index([userId, createdAt(sort: Desc)])
  @@map("saved_learnings")
}

model UserPreference {
  id               String   @id @default(uuid())
  userId           String   @unique
  language         String   @default("english")
  explanationLevel String   @default("balanced")
  teachingStyle    String   @default("friendly")
  learningGoals    Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model UserAvatar {
  id         String   @id @default(uuid())
  userId     String
  avatarType String   @default("preset")
  avatarData Json
  isActive   Boolean  @default(false)
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_avatars")
}

model VideoJob {
  id            String   @id @default(uuid())
  userId        String
  sessionId     String?
  topic         String
  script        String?
  status        String   @default("pending")
  provider      String   @default("none")
  externalJobId String?
  resultUrl     String?
  errorMessage  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  session LearningSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
  @@index([status])
  @@map("video_jobs")
}

model FileUpload {
  id        String   @id @default(uuid())
  userId    String
  filename  String
  mimeType  String
  size      Int
  path      String
  content   String?
  status    String   @default("uploaded")
  metadata  Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@map("file_uploads")
}
