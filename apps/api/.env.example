# NoviLearn Backend Configuration

# Node Environment
NODE_ENV=development
PORT=3001

# PostgreSQL Database URL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/novilearn?schema=public"

# JWT Auth Secret
JWT_SECRET="your-super-secret-jwt-key-min-32-chars"

# AI Provider Configuration
# Supported: "gemini", "openai", "anthropic"
AI_PROVIDER="gemini"
GEMINI_API_KEY="your-gemini-api-key"
OPENAI_API_KEY="sk-proj-your-openai-api-key"
ANTHROPIC_API_KEY="sk-ant-your-anthropic-api-key"

# AI Video Generation Provider Configuration
# Supported: "d-id", "heygen", "none" (default fallback)
VIDEO_PROVIDER="none"

# Provider Specific API Keys
D_ID_API_KEY="your-d-id-api-key-basic-auth-hash"
HEYGEN_API_KEY="your-heygen-x-api-key"
VIDEO_API_KEY="your-video-provider-key-fallback"

# Sentry Error Tracking (Optional)
SENTRY_DSN=""
